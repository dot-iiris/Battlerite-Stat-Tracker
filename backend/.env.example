# Copy to backend/.env and fill in. Never commit .env.
# Admins can change the non-secret settings below on the website's Settings page; a value
# changed there replaces the one here until it's reset.

MONGO_URL=mongodb://localhost:27017
DB_NAME=brstats
# Any long random string; signs login tokens
JWT_SECRET=
# The admin account created on first start
ADMIN_EMAIL=
ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:3000

# Optional: Discord login (Discord Developer Portal > OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8001/api/auth/discord/callback
FRONTEND_URL=http://localhost:3000
# Discord user IDs (comma separated) that become admins when they log in
DISCORD_ADMIN_IDS=

# Optional: Discord webhooks
DISCORD_MATCH_LOG_WEBHOOK_URL=
DISCORD_LEADERBOARD_WEBHOOK_URL=
DISCORD_LEADERBOARD_SIZE=25
# Used for links in the webhook posts
PUBLIC_SITE_URL=

# Optional: screenshot storage cap in MB (default 1024) and CPU threads for
# screenshot reading (default 1)
SCREENSHOT_STORAGE_MB=
OCR_THREADS=

# Team balancing (optional - these are the defaults)
#   BALANCE_ROLE_MODEL  role_mmr = hidden per-role MMR picks each team's best role line-up (default)
#                       spread   = the old check of how varied the teams' most-played roles are
#   HYBRID_MMR_WEIGHT   Hybrid Balance: share of general MMR, the rest is the role part (0-1, old value 0.6)
#   SUPPORT_WEIGHT_2V2  2v2: how much the Support counts in a team's role line-up (0-1)
BALANCE_ROLE_MODEL=role_mmr
HYBRID_MMR_WEIGHT=0.8
SUPPORT_WEIGHT_2V2=0.6

# bot-integration branch only: shared secret the Discord bot sends (X-Bot-Key)
BOT_API_KEY=
