#!/usr/bin/env bash
# BR Stats - pull the latest code, rebuild and restart.   Usage: sudo brstats-update
#   --no-pull   rebuild what's already there
set -euo pipefail
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"
APP=/opt/brstats
SITE=$APP/site
as_app() { sudo -u brstats -H env HOME="$APP" "$@"; }
log() { echo "==> $*"; }

if [ "${1:-}" != "--no-pull" ]; then
  log "Pulling the latest code"
  as_app git -C "$SITE" pull --ff-only
fi

# keep the helper commands in step with the code
install -m 755 "$SITE/deploy/brstats-update" /usr/local/bin/brstats-update
install -m 755 "$SITE/deploy/brstats-finish" /usr/local/bin/brstats-finish

log "Backend packages"
[ -x "$APP/venv/bin/python" ] || as_app python3 -m venv "$APP/venv"
as_app "$APP/venv/bin/pip" install -q --disable-pip-version-check --upgrade pip
as_app "$APP/venv/bin/pip" install -q --disable-pip-version-check -r "$SITE/deploy/requirements-server.txt"

log "Building the website"
as_app tee "$SITE/frontend/.env.production.local" >/dev/null <<'EOF'
REACT_APP_BACKEND_URL=
DISABLE_EMERGENT_OVERLAY=true
ENABLE_HEALTH_CHECK=false
GENERATE_SOURCEMAP=false
EOF
cd "$SITE/frontend"
as_app npx --yes yarn@1.22.22 install --network-timeout 600000
# build next to the live site, then swap it in, so the site never goes down mid-build
rm -rf build.new build.old
as_app env BUILD_PATH=build.new npx --yes yarn@1.22.22 build
[ -f build.new/index.html ] || { echo "Build failed - the site was left as it was"; exit 1; }
[ -d build ] && mv build build.old
mv build.new build
rm -rf build.old

if [ -f "$APP/bot/requirements.txt" ]; then
  log "Bot packages"
  [ -x "$APP/bot/.venv/bin/python" ] || as_app python3 -m venv "$APP/bot/.venv"
  as_app "$APP/bot/.venv/bin/pip" install -q --disable-pip-version-check -r "$APP/bot/requirements.txt"
fi

# the website backend picks up the new code; the bot isn't touched (its code and
# settings only change through upload-to-oracle / brstats-finish)
if systemctl is-enabled --quiet brstats-api 2>/dev/null; then
  systemctl restart brstats-api
  log "Restarted the website backend (the bot kept running)"
fi
log "Done"
