#!/usr/bin/env bash
# BR Stats - pull the latest code, rebuild and restart.   Usage: sudo brstats-update
#   --no-pull   rebuild what's already there
#   --force     redo every step even if nothing changed
# Only the parts that changed are rebuilt: no backend restart for frontend-only
# changes, no site rebuild for backend-only changes, no reinstalls if packages didn't change.
set -euo pipefail
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"
APP=/opt/brstats
SITE=$APP/site
STAMPS=$APP/.stamps
as_app() { sudo -u brstats -H env HOME="$APP" "$@"; }
log() { echo "==> $*"; }
PULL=1; FORCE=0
for a in "$@"; do
  case "$a" in --no-pull) PULL=0 ;; --force) FORCE=1 ;; esac
done
mkdir -p "$STAMPS"
# "has this changed since we last did it?" - compares a fingerprint with the saved one
changed() { [ "$FORCE" = 1 ] || [ "$(cat "$STAMPS/$1" 2>/dev/null)" != "$2" ]; }
done_with() { echo "$2" > "$STAMPS/$1"; }

if [ "$PULL" = 1 ]; then
  log "Pulling the latest code"
  as_app git -C "$SITE" pull --ff-only
fi

# keep the helper commands in step with the code
install -m 755 "$SITE/deploy/brstats-update" /usr/local/bin/brstats-update
install -m 755 "$SITE/deploy/brstats-finish" /usr/local/bin/brstats-finish

# compress text (pages, scripts, API answers) - much smaller downloads
if [ ! -f /etc/nginx/conf.d/brstats-gzip.conf ]; then
  cat > /etc/nginx/conf.d/brstats-gzip.conf <<'NGX'
gzip_vary on;
gzip_proxied any;
gzip_min_length 1024;
gzip_types text/plain text/css application/json application/javascript text/javascript image/svg+xml;
NGX
  if nginx -t 2>/dev/null; then systemctl reload nginx; log "Turned on compression"; else rm -f /etc/nginx/conf.d/brstats-gzip.conf; fi
fi

# a little swap, so a build on the server can't run it out of memory
if [ -z "$(swapon --show 2>/dev/null)" ] && [ ! -f /swapfile ]; then
  if fallocate -l 2G /swapfile 2>/dev/null && chmod 600 /swapfile && mkswap /swapfile >/dev/null && swapon /swapfile; then
    grep -q '^/swapfile ' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab
    log "Added 2 GB of swap"
  else
    rm -f /swapfile
  fi
fi

# which version of a folder is checked out. Asked as the site's own user: git refuses to read a
# repository owned by someone else ("dubious ownership"), which made every update look unchanged.
tree() { as_app git -C "$SITE" rev-parse "HEAD:$1" 2>/dev/null || echo "unknown-$(date +%s)"; }

# swap a finished build in, so the site never shows a half-built page
install_build() {
  [ -f "$1/index.html" ] || return 1
  chown -R brstats:brstats "$1"
  rm -rf "$SITE/frontend/build.old"
  [ -d "$SITE/frontend/build" ] && mv "$SITE/frontend/build" "$SITE/frontend/build.old"
  mv "$1" "$SITE/frontend/build"
  rm -rf "$SITE/frontend/build.old"
}

REQ=$(sha256sum "$SITE/backend/requirements.txt" | cut -c1-16)
if [ ! -x "$APP/venv/bin/python" ] || changed backend-req "$REQ"; then
  log "Backend packages"
  [ -x "$APP/venv/bin/python" ] || as_app python3 -m venv "$APP/venv"
  as_app "$APP/venv/bin/pip" install -q --disable-pip-version-check --upgrade pip
  as_app "$APP/venv/bin/pip" install -q --disable-pip-version-check -r "$SITE/backend/requirements.txt"
  done_with backend-req "$REQ"
fi

FRONT=$(tree frontend)
PREBUILT=/tmp/brstats-web-$FRONT.tgz   # built on your PC by update-oracle.bat
if [ -f "$PREBUILT" ] && { [ ! -f "$SITE/frontend/build/index.html" ] || changed frontend "$FRONT"; }; then
  log "Installing the website build from your PC"
  rm -rf "$SITE/frontend/build.new"; mkdir -p "$SITE/frontend/build.new"
  if tar -xzf "$PREBUILT" -C "$SITE/frontend/build.new" && install_build "$SITE/frontend/build.new"; then
    done_with frontend "$FRONT"
  else
    rm -rf "$SITE/frontend/build.new"; echo "    That build was incomplete - building here instead"
  fi
fi
rm -f /tmp/brstats-web-*.tgz
if [ ! -f "$SITE/frontend/build/index.html" ] || changed frontend "$FRONT"; then
  log "Building the website on the server (the live site keeps running; this takes a while)"
  SITE_URL=$(grep -E '^PUBLIC_SITE_URL=' "$APP/backend.env" | tail -1 | cut -d= -f2- | tr -d '"'"'"' \r' | sed 's#/*$##')
  as_app tee "$SITE/frontend/.env.production.local" >/dev/null <<EOF2
REACT_APP_BACKEND_URL=
REACT_APP_SITE_URL=$SITE_URL
GENERATE_SOURCEMAP=false
EOF2
  cd "$SITE/frontend"
  LOCK=$(sha256sum yarn.lock | cut -c1-16)
  if [ ! -d node_modules ] || changed frontend-lock "$LOCK"; then
    as_app nice -n 19 npx --yes yarn@1.22.22 install --network-timeout 600000
    done_with frontend-lock "$LOCK"
  fi
  # lowest CPU/disk priority and capped memory, so the API and database stay responsive meanwhile
  rm -rf build.new
  as_app env BUILD_PATH=build.new NODE_OPTIONS=--max-old-space-size=1536 \
    nice -n 19 ionice -c 3 npx --yes yarn@1.22.22 build
  install_build "$SITE/frontend/build.new" || { echo "Build failed - the site was left as it was"; exit 1; }
  done_with frontend "$FRONT"
else
  log "Website up to date"
fi

if [ -f "$APP/bot/requirements.txt" ]; then
  BREQ=$(sha256sum "$APP/bot/requirements.txt" | cut -c1-16)
  if [ ! -x "$APP/bot/.venv/bin/python" ] || changed bot-req "$BREQ"; then
    log "Bot packages"
    [ -x "$APP/bot/.venv/bin/python" ] || as_app python3 -m venv "$APP/bot/.venv"
    as_app "$APP/bot/.venv/bin/pip" install -q --disable-pip-version-check -r "$APP/bot/requirements.txt"
    done_with bot-req "$BREQ"
  fi
fi

# the website backend picks up new code; the bot isn't touched (its code and
# settings only change through upload-to-oracle / brstats-finish)
BACK="$(tree backend)$REQ"
if systemctl is-enabled --quiet brstats-api 2>/dev/null; then
  if changed backend "$BACK"; then
    systemctl restart brstats-api
    log "Restarted the website backend (the bot kept running)"
  else
    log "Backend unchanged - not restarted"
  fi
fi
done_with backend "$BACK"
log "Done"
